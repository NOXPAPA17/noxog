		MaxZoom = LocalPlayer.CameraMaxZoomDistance,
	}

	Section(VisualPage, "WORLD")

	Toggle(VisualPage, "💡  FULLBRIGHT", false, function(on)
		if on then
			Lighting.Brightness = 2
			Lighting.Ambient = Color3.fromRGB(255, 255, 255)
			Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
		else
			Lighting.Brightness = orig.Brightness
			Lighting.Ambient = orig.Ambient
			Lighting.OutdoorAmbient = orig.OutdoorAmbient
		end
	end)

	Slider(VisualPage, "BRIGHTNESS", 0, 10, math.clamp(orig.Brightness, 0, 10), function(v) Lighting.Brightness = v end)

	Toggle(VisualPage, "🌫  NO FOG", false, function(on)
		if on then
			Lighting.FogEnd = 1e9
			Lighting.FogStart = 1e9
		else
			Lighting.FogEnd = orig.FogEnd
			Lighting.FogStart = orig.FogStart
		end
	end)

	Toggle(VisualPage, "🌑  NO SHADOWS", false, function(on)
		Lighting.GlobalShadows = not on and orig.GlobalShadows or false
	end)

	Slider(VisualPage, "TIME OF DAY", 0, 24, math.clamp(orig.ClockTime, 0, 24), function(v) Lighting.ClockTime = v end)

	-- colour grading
	local cc = Lighting:FindFirstChild("LL_ColorCorrection") or Instance.new("ColorCorrectionEffect")
	cc.Name = "LL_ColorCorrection"
	cc.Enabled = false
	cc.Parent = Lighting
	Toggle(VisualPage, "🎞  BLACK & WHITE", false, function(on)
		cc.Enabled = on
		cc.Saturation = on and -1 or 0
	end)
	Slider(VisualPage, "SATURATION", -10, 10, 0, function(v)
		cc.Enabled = true
		cc.Saturation = v / 10
	end)

	local bloom = Lighting:FindFirstChild("LL_Bloom") or Instance.new("BloomEffect")
	bloom.Name = "LL_Bloom"
	bloom.Enabled = false
	bloom.Intensity = 1.2
	bloom.Size = 40
	bloom.Threshold = 0.8
	bloom.Parent = Lighting
	Toggle(VisualPage, "✨  BLOOM GLOW", false, function(on) bloom.Enabled = on end)

	Section(VisualPage, "CAMERA")

	Slider(VisualPage, "FIELD OF VIEW", 30, 120, math.clamp(orig.FOV, 30, 120), function(v)
		local c = cam()
		if c then c.FieldOfView = v end
	end)

	Toggle(VisualPage, "🔭  UNLIMITED ZOOM", false, function(on)
		LocalPlayer.CameraMaxZoomDistance = on and 100000 or orig.MaxZoom
	end)

	Toggle(VisualPage, "🧱  X-RAY (SEE THROUGH WALLS)", false, function(on)
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("BasePart") and not d:IsDescendantOf(LocalPlayer.Character or workspace) then
				local isChar = false
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Character and d:IsDescendantOf(p.Character) then isChar = true break end
				end
				if not isChar then d.LocalTransparencyModifier = on and 0.6 or 0 end
			end
		end
	end)

	Section(VisualPage, "PLAYER ESP")

	local espFolder = coreGui:FindFirstChild("LL_ESP") or Instance.new("Folder")
	espFolder.Name = "LL_ESP"
	espFolder.Parent = coreGui

	local espChams, espNames, espHealth = false, false, false
	local rainbow = true

	local function ClearESP(plr)
		local f = espFolder:FindFirstChild(plr.Name)
		if f then f:Destroy() end
	end

	local function BuildESP(plr)
		ClearESP(plr)
		if plr == LocalPlayer or not plr.Character then return end
		local f = Instance.new("Folder")
		f.Name = plr.Name
		f.Parent = espFolder
		local char = plr.Character
		if espChams then
			local h = Instance.new("Highlight")
			h.Name = "Chams"
			h.Adornee = char
			h.FillTransparency = 0.6
			h.OutlineTransparency = 0
			h.FillColor = Accent
			h.OutlineColor = Color3.new(1, 1, 1)
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Parent = f
		end
		local head = char:FindFirstChild("Head")
		if head and (espNames or espHealth) then
			local bb = Instance.new("BillboardGui")
			bb.Name = "Info"
			bb.Adornee = head
			bb.Size = UDim2.fromOffset(180, 36)
			bb.StudsOffset = Vector3.new(0, 2.6, 0)
			bb.AlwaysOnTop = true
			bb.Parent = f
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.fromScale(1, 1)
			lbl.BackgroundTransparency = 1
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 13
			lbl.TextColor3 = Color3.new(1, 1, 1)
			lbl.TextStrokeTransparency = 0.3
			lbl.Parent = bb
			task.spawn(function()
				while lbl.Parent and char.Parent do
					local hum = char:FindFirstChildOfClass("Humanoid")
					local root = char:FindFirstChild("HumanoidRootPart")
					local _, _, myRoot = GetChar()
					local parts = {}
					if espNames then table.insert(parts, plr.DisplayName) end
					if espNames and root and myRoot then
						table.insert(parts, math.floor((root.Position - myRoot.Position).Magnitude) .. " studs")
					end
					if espHealth and hum then table.insert(parts, "HP " .. math.floor(hum.Health)) end
					lbl.Text = table.concat(parts, "  •  ")
					task.wait(0.2)
				end
			end)
		end
	end

	local function RefreshESP()
		for _, plr in ipairs(Players:GetPlayers()) do
			if espChams or espNames or espHealth then BuildESP(plr) else ClearESP(plr) end
		end
	end

	Players.PlayerAdded:Connect(function(plr)
		plr.CharacterAdded:Connect(function()
			task.wait(1)
			if espChams or espNames or espHealth then BuildESP(plr) end
		end)
	end)
	for _, plr in ipairs(Players:GetPlayers()) do
		plr.CharacterAdded:Connect(function()
			task.wait(1)
			if espChams or espNames or espHealth then BuildESP(plr) end
		end)
	end
	Players.PlayerRemoving:Connect(ClearESP)

	Toggle(VisualPage, "🟥  PLAYER CHAMS (HIGHLIGHT)", false, function(on) espChams = on RefreshESP() end)
	Toggle(VisualPage, "🏷  NAME + DISTANCE ESP", false, function(on) espNames = on RefreshESP() end)
	Toggle(VisualPage, "❤  HEALTH ESP", false, function(on) espHealth = on RefreshESP() end)

	Section(VisualPage, "SELF")

	local selfHL
	local selfConn
	Toggle(VisualPage, "🌈  RAINBOW GLOW (YOU)", false, function(on)
		if selfConn then selfConn:Disconnect() selfConn = nil end
		if selfHL then selfHL:Destroy() selfHL = nil end
		if on then
			selfHL = Instance.new("Highlight")
			selfHL.FillTransparency = 0.5
			selfHL.OutlineTransparency = 0
			selfHL.Parent = coreGui
			selfConn = RunService.RenderStepped:Connect(function()
				local c = LocalPlayer.Character
				if selfHL then
					selfHL.Adornee = c
					local col = Color3.fromHSV((os.clock() % 3) / 3, 0.9, 1)
					selfHL.FillColor = col
					selfHL.OutlineColor = col
				end
			end)
		end
	end)

	Section(VisualPage, "HIDE UI")

	local StarterGui = game:GetService("StarterGui")
	local hiddenGuis = {}
	local function SetGameUIHidden(on)
		if on then
			local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
			if pg then
				for _, g in ipairs(pg:GetChildren()) do
					if g:IsA("ScreenGui") and g.Enabled then
						hiddenGuis[g] = true
						g.Enabled = false
					end
				end
			end
			pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
		else
			for g in pairs(hiddenGuis) do
				if g.Parent then g.Enabled = true end
			end
			table.clear(hiddenGuis)
			pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true) end)
		end
	end
	Toggle(VisualPage, "🙈  HIDE GAME UI (clean screen)", false, SetGameUIHidden)

	Toggle(VisualPage, "🏷  HIDE PLAYER NAMES / HEALTH BARS", false, function(on)
		for _, plr in ipairs(Players:GetPlayers()) do
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.DisplayDistanceType = on and Enum.HumanoidDisplayDistanceType.None or Enum.HumanoidDisplayDistanceType.Viewer
			end
		end
	end)

	Button(VisualPage, "♻  RESET ALL VISUALS", function()
		Lighting.Brightness = orig.Brightness
		Lighting.Ambient = orig.Ambient
		Lighting.OutdoorAmbient = orig.OutdoorAmbient
		Lighting.FogEnd = orig.FogEnd
		Lighting.FogStart = orig.FogStart
		Lighting.ClockTime = orig.ClockTime
		Lighting.GlobalShadows = orig.GlobalShadows
		cc.Enabled = false
		bloom.Enabled = false
		local c = cam()
		if c then c.FieldOfView = orig.FOV end
		LocalPlayer.CameraMaxZoomDistance = orig.MaxZoom
		SetGameUIHidden(false)
	end)
end

