-- music
local CurrentMusic
local CurrentSongIndex
local MusicVolume = 5
local MusicScale = 1          -- 1 for Roblox-hosted phonks, 0.2 for the embedded songs (they are already loud)
local PlayToken = 0
local MusicStateHooks = {}    -- buttons register here so they flip back to OFF when music stops

local function StopPhonk()
	PlayToken = PlayToken + 1
	CurrentSongIndex = nil
	if CurrentMusic then CurrentMusic:Destroy() CurrentMusic = nil end
	for _, fn in ipairs(MusicStateHooks) do pcall(fn) end
end
local function PlayPhonk(id)
	StopPhonk()
	MusicScale = 1
	CurrentMusic = New("Sound", {SoundId = "rbxassetid://" .. id, Volume = MusicVolume, Looped = true}, SoundService)
	CurrentMusic:Play()
end

-- full-length songs: built into this script, saved to a file the first time each one is played
local function EnsureSong(i)
	local getAsset = getcustomasset or getsynasset
	if not (getAsset and type(writefile) == "function") then return nil, "unsupported" end
	local name = "ll_song7_" .. i .. ".mp3"
	local ok, asset = pcall(function()
		if not FileIsGood(name, SONGS[i].size) then writefile(name, b64decode(SONGS[i].b64, 15000)) end
		return getAsset(name)
	end)
	if ok and asset then return asset end
	return nil, "unsupported"
end
local function PlaySong(i, setState)
	StopPhonk()
	local token = PlayToken
	CurrentSongIndex = i
	setState("LOADING")
	task.spawn(function()
		local asset, why = EnsureSong(i)
		if token ~= PlayToken then return end
		if not asset then
			CurrentSongIndex = nil
			setState(why == "pack" and "NEED PACK" or "ERROR")
			return
		end
		local snd = New("Sound", {SoundId = asset, Volume = MusicVolume * 0.2, Looped = true}, SoundService)
		local t0 = os.clock()
		while not snd.IsLoaded and os.clock() - t0 < 8 do task.wait(0.1) end
		if token ~= PlayToken then snd:Destroy() return end
		MusicScale = 0.2
		CurrentMusic = snd
		snd:Play()
		setState("ON")
	end)
end

