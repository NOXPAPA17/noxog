-- the uploaded mp4 (1280x720) plays in a VideoFrame; the first-frame picture shows until it is ready
local function BuildVideoLayers(e)
	local scale = math.max(e.w / 1280, e.h / 720)
	local size = UDim2.fromOffset(math.ceil(1280 * scale), math.ceil(720 * scale))
	if BG.PosterAsset and not e.poster then
		e.poster = New("ImageLabel", {Name = "Poster", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = size,
			BackgroundTransparency = 1, BorderSizePixel = 0, Image = BG.PosterAsset, ZIndex = e.z + 1}, e.holder)
	end
	if BG.VideoAsset and not e.video then
		local v = New("VideoFrame", {Name = "BGVideo", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = size,
			BackgroundTransparency = 1, BorderSizePixel = 0, Video = BG.VideoAsset, Looped = true, Volume = 0, ZIndex = e.z + 2}, e.holder)
		e.video = v
		pcall(function() v:Play() end)
		task.spawn(function()
			local t0 = os.clock()
			while v.Parent and not v.IsLoaded and os.clock() - t0 < 15 do task.wait(0.1) end
			if not v.Parent then return end
			if v.IsLoaded then
				pcall(function() v:Play() end)
				task.wait(0.4)
				if e.fallback then e.fallback:Destroy() e.fallback = nil end
			else
				v:Destroy()
				e.video = nil
				e.videoFailed = true
				if not BG.VideoWarned then
					BG.VideoWarned = true
					__llToast("Video format not supported by this executor: showing the picture instead (music still works).", false)
				end
			end
		end)
	end
end

task.spawn(function()
	while true do
		for i = #BG.Entries, 1, -1 do
			local e = BG.Entries[i]
			if not e.holder.Parent then
				table.remove(BG.Entries, i)
			elseif not e.videoFailed then
				pcall(BuildVideoLayers, e)
			end
		end
		task.wait(0.25)
	end
end)

-- background: embedded video frames, or an animated gradient + particles while loading / if unsupported
local function BuildBackground(parent, zindex, w, h, noVideo)
	local holder = New("Frame", {Name = "BG", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 6, 10),
		BorderSizePixel = 0, ClipsDescendants = true, ZIndex = zindex or 1}, parent)

	local fb = New("Frame", {Name = "Fallback", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ZIndex = zindex or 1}, holder)
	local grad = New("Frame", {Size = UDim2.fromScale(2, 2), Position = UDim2.fromScale(-0.5, -0.5),
		BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = zindex or 1}, fb)
	local ug = New("UIGradient", {Rotation = 0}, grad)
	OnAccent(function(c)
		ug.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 4, 8)),
			ColorSequenceKeypoint.new(0.5, c:Lerp(Color3.new(0, 0, 0), 0.65)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 4, 8)),
		})
	end)
	task.spawn(function()
		while grad.Parent do
			ug.Rotation = (os.clock() * 12) % 360
			task.wait(1 / 30)
		end
	end)
	for i = 1, 14 do
		local size = math.random(3, 7)
		local p = New("Frame", {Size = UDim2.fromOffset(size, size), BackgroundColor3 = WHITE, BackgroundTransparency = 0.6,
			BorderSizePixel = 0, Position = UDim2.fromScale(math.random(), math.random()), ZIndex = (zindex or 1) + 1}, fb)
		Corner(p, 8)
		OnAccent(function(c) p.BackgroundColor3 = c end)
		task.spawn(function()
			while p.Parent do
				local t = math.random(40, 90) / 10
				local tw = Tween(p, t, {Position = UDim2.fromScale(math.random(), math.random()),
					BackgroundTransparency = math.random(40, 90) / 100}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				tw.Completed:Wait()
			end
		end)
	end

	if CONFIG.BackgroundVideo and not noVideo then
		table.insert(BG.Entries, {holder = holder, fallback = fb, w = w or 660, h = h or 430, z = zindex or 1})
	end
	return holder
end

