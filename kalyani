		task.wait(1 / 40)
	end
end)
local TogMoved = MakeDraggable(Toggler, Toggler)

local open = false
local uiHidden = false
local function SetOpen(state)
	open = state
	if state then
		if not uiHidden then Main.Visible = true end
		Tween(MainScale, 0.45, {Scale = FitScale()}, Enum.EasingStyle.Back)
	else
		local tw = Tween(MainScale, 0.25, {Scale = 0.01}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		tw.Completed:Connect(function()
			if not open or uiHidden then Main.Visible = false end
		end)
	end
end

local function WatchViewport()
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if open then MainScale.Scale = FitScale() end
		end)
	end
end
WatchViewport()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(WatchViewport)

