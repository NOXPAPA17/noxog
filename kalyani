local flyBV, flyConn
local function SetFly(on)
	State.Fly = on
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if flyBV then flyBV:Destroy() flyBV = nil end
	local _, hum, root = GetChar()
	if hum then hum.PlatformStand = false end
	if not on or not root then return end
	flyBV = New("BodyVelocity", {MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero}, root)
	flyConn = RunService.RenderStepped:Connect(function()
		local _, h, r = GetChar()
		if not h or not r or not flyBV or not flyBV.Parent then return end
		h.PlatformStand = true
		local cam = workspace.CurrentCamera
		local dir = h.MoveDirection
		local v = dir * State.FlySpeed
		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 and dir.Magnitude > 0.05 then
			v = v + Vector3.new(0, look.Y * State.FlySpeed * math.max(dir:Dot(flat.Unit), 0), 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then v = v + Vector3.new(0, State.FlySpeed, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then v = v - Vector3.new(0, State.FlySpeed, 0) end
		flyBV.Velocity = v
	end)
end
