-- on-screen message box so errors are visible on phones too
local function __llToast(msg, isError)
	pcall(function()
		local holder
		local getters = {
			function() return gethui and gethui() end,
			function() return game:GetService("CoreGui") end,
			function() return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui", 5) end,
		}
		for _, get in ipairs(getters) do
			local ok, parent = pcall(get)
			if ok and parent then
				pcall(function() local old = parent:FindFirstChild("LL_TOAST") if old then old:Destroy() end end)
				local sg = Instance.new("ScreenGui")
				sg.Name = "LL_TOAST"
				sg.ResetOnSpawn = false
				sg.IgnoreGuiInset = true
				sg.DisplayOrder = 999999
				local okP = pcall(function() sg.Parent = parent end)
				if okP and sg.Parent == parent then holder = sg break end
				pcall(function() sg:Destroy() end)
			end
		end
		if not holder then return end
		local l = Instance.new("TextLabel")
		l.AnchorPoint = Vector2.new(0.5, 0)
		l.Position = UDim2.new(0.5, 0, 0, 8)
		l.Size = UDim2.new(0.92, 0, 0, isError and 120 or 28)
		l.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
		l.BackgroundTransparency = 0.15
		l.TextColor3 = isError and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(235, 235, 245)
		l.TextWrapped = true
		l.TextSize = 14
		l.Font = Enum.Font.GothamMedium
		l.Text = tostring(msg)
		l.Parent = holder
		Instance.new("UICorner", l).CornerRadius = UDim.new(0, 8)
		task.delay(isError and 60 or 4, function() pcall(function() holder:Destroy() end) end)
	end)
end
